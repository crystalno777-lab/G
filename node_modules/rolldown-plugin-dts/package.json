{
  "name": "rolldown-plugin-dts",
  "type": "module",
  "version": "0.29.0",
  "description": "A Rolldown plugin to generate and bundle dts files.",
  "author": "Kevin Deng <sxzz@sxzz.moe>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/sxzz",
  "homepage": "https://github.com/sxzz/rolldown-plugin-dts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxzz/rolldown-plugin-dts.git"
  },
  "bugs": {
    "url": "https://github.com/sxzz/rolldown-plugin-dts/issues"
  },
  "keywords": [
    "rolldown",
    "plugin",
    "rolldown-plugin",
    "vite-plugin",
    "dts",
    "typescript",
    "tsrs",
    "vue",
    "jsdoc",
    "volar"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./internal": "./dist/internal.mjs",
    "./tsc": "./dist/tsc.mjs",
    "./tsc-context": "./dist/tsc-context.mjs",
    "./tsc-worker": "./dist/tsc-worker.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "peerDependencies": {
    "@volar/typescript": "~2.4.0",
    "@vue/language-core": "~3.2.0 || ~3.3.0",
    "rolldown": "^1.2.0",
    "tsrs": "*",
    "typescript": "^5.0.0 || ^6.0.0 || ~7.0.0 || ~7.1.0-0",
    "vue-tsc": "~3.2.0 || ~3.3.0"
  },
  "peerDependenciesMeta": {
    "@volar/typescript": {
      "optional": true
    },
    "@vue/language-core": {
      "optional": true
    },
    "tsrs": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vue-tsc": {
      "optional": true
    }
  },
  "dependencies": {
    "dts-resolver": "^3.0.0",
    "get-tsconfig": "5.0.0-beta.6",
    "obug": "^3.0.0",
    "yuku": "^0.25.0"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.12",
    "@jridgewell/source-map": "^0.3.11",
    "@sxzz/eslint-config": "^8.9.2",
    "@sxzz/prettier-config": "^2.3.3",
    "@sxzz/test-utils": "^0.5.20",
    "@ts-macro/language-plugin": "^0.3.7",
    "@ts-macro/tsc": "^0.3.7",
    "@types/node": "^26.6.6",
    "@volar/typescript": "^2.4.30",
    "@vue/language-core": "^3.3.13",
    "arktype": "^2.2.9",
    "bumpp": "^12.3.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "rolldown": "^1.2.15",
    "ts-macro": "^0.3.7",
    "tsdown": "^0.23.3",
    "tsnapi": "^1.5.0",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "^6.0.3",
    "typescript-next": "npm:typescript@7.1.0-dev.20261025.1",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13",
    "zod": "^4.6.7"
  },
  "prettier": "@sxzz/prettier-config",
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --cache --write .",
    "release": "bumpp"
  }
}